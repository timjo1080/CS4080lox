class Circle {
  init(radius) {
    this.radius = radius;
  }

  // Getter: accessed without ()
  area {
    return 3.141592653 * this.radius * this.radius;
  }

  // Normal method: requires ()
  doubleRadius() {
    return this.radius * 2;
  }
}

var circle = Circle(4);

print circle.radius;
print circle.area;
print circle.doubleRadius();